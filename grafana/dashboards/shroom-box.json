          "query": "from(bucket: \"homeassistant\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r[\"entity_id\"] == \"main_esp32_tent_humidity\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> min()"
